{
  "name": "floorball-3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Test runner + CI build/size-check tooling. The app itself still ships with zero build step for local dev - see CLAUDE.md - this only stages a minified dist/ for deploy.",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "check:size": "node scripts/check-size.mjs",
    "label:goals": "node scripts/label-goals.mjs",
    "eval:goals": "node scripts/eval-goal-detect.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "three": "0.160.0"
  }
}
